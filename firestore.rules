rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null}
  match /accounts/{id} {
   allow read: if signedIn() && request.auth.uid == id;
   allow write: if false;
   match /recordings/{rid} {
    allow read: if signedIn() && request.auth.uid == id;
    allow write: if false;
   }
   match /audit/{eventId} {
    allow read: if signedIn() && request.auth.uid == id;
    allow write: if false;
   }
  }
 }
}